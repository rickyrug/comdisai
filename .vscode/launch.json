{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        
        
        {
            "name": "Launch ComdisAI (.NET)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/ComdisAI/bin/Debug/net10.0/ComdisAI.dll",
            "cwd": "${workspaceFolder}/ComdisAI",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "launchSettingsProfile": "http",
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Launch Chrome (app must already be running)",
            "url": "http://localhost:5129",
            "webRoot": "${workspaceFolder}/ComdisAI/wwwroot"
        }
    ]
}