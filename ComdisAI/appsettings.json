{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "File": {
      "Directory": "logs",
      "RetentionDays": 30
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=comdisai.db"
  },
  "BootstrapAdmin": {
    "InitialPassword": "admin",
    "Email": "admin@admin.com"

  },
  "AllowedHosts": "*"
}
