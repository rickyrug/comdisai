@model ComdisAI.ViewModels.Logs.AppLogDashboard
@{
    ViewData["Title"] = "Application Logs";
    ViewData["FullWidth"] = true;
    var route = new Dictionary<string, string?> {
        ["From"] = Model.From?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"), ["To"] = Model.To?.UtcDateTime.ToString("yyyy-MM-ddTHH:mm"),
        ["Level"] = Model.Level, ["Source"] = Model.Source, ["Search"] = Model.Search,
        ["ExceptionsOnly"] = Model.ExceptionsOnly.ToString(), ["PageSize"] = Model.PageSize.ToString()
    };
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3"><h1 class="h3 mb-0">Application Logs</h1><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Usability">Application Usability</a><a class="btn btn-outline-secondary" asp-controller="Logs" asp-action="Index">Historical Logs</a></div></div>
<form asp-action="AppLogs" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="from">From (UTC)</label><input class="form-control" id="from" name="From" type="datetime-local" value="@route["From"]" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="to">To (UTC)</label><input class="form-control" id="to" name="To" type="datetime-local" value="@route["To"]" /></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="level">Level</label><select class="form-select" id="level" name="Level">@foreach (var level in new[] { "All", "ErrorOrAbove", "WarningOrAbove", "Error", "Warning", "Information", "Debug" }) { <option value="@level" selected="@(Model.Level == level)">@level</option> }</select></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="source">Source</label><select class="form-select" id="source" name="Source"><option value="">All</option>@foreach (var source in Model.Sources) { <option value="@source" selected="@(Model.Source == source)">@source.Split('.').Last()</option> }</select></div>
    <div class="col-sm-6 col-lg-2"><label class="form-label" for="search">Search</label><input class="form-control" id="search" name="Search" type="search" value="@Model.Search" maxlength="200" /></div>
    <div class="col-sm-6 col-lg-2"><div class="form-check mb-2"><input class="form-check-input" type="checkbox" id="exceptions" name="ExceptionsOnly" value="true" checked="@Model.ExceptionsOnly" /><label class="form-check-label" for="exceptions">With stack trace only</label></div></div>
    <div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit">Apply</button><a class="btn btn-outline-secondary" asp-action="AppLogs">Reset</a></div>
</form>
<div class="row row-cols-2 row-cols-lg-4 g-3 mb-4">
    @{ var errors = new Dictionary<string, string?>(route) { ["Level"] = "ErrorOrAbove", ["ExceptionsOnly"] = "false" }; var warnings = new Dictionary<string, string?>(route) { ["Level"] = "Warning", ["ExceptionsOnly"] = "false" }; var exceptions = new Dictionary<string, string?>(route) { ["Level"] = "All", ["ExceptionsOnly"] = "true" }; var total = new Dictionary<string, string?>(route) { ["Level"] = "All", ["ExceptionsOnly"] = "false" }; }
    <div class="col"><a class="border rounded p-3 d-block text-decoration-none h-100" asp-action="AppLogs" asp-all-route-data="errors"><span class="text-muted small d-block">Errors / Fatal</span><strong>@Model.ErrorCount</strong></a></div>
    <div class="col"><a class="border rounded p-3 d-block text-decoration-none h-100" asp-action="AppLogs" asp-all-route-data="warnings"><span class="text-muted small d-block">Warnings</span><strong>@Model.WarningCount</strong></a></div>
    <div class="col"><a class="border rounded p-3 d-block text-decoration-none h-100" asp-action="AppLogs" asp-all-route-data="exceptions"><span class="text-muted small d-block">Stack Traces</span><strong>@Model.ExceptionCount</strong></a></div>
    <div class="col"><a class="border rounded p-3 d-block text-decoration-none h-100" asp-action="AppLogs" asp-all-route-data="total"><span class="text-muted small d-block">Total Entries</span><strong>@Model.TotalEntries</strong></a></div>
</div>
<h2 class="h5">Application Log Entries</h2>
<div class="table-responsive"><table class="table table-striped table-sm"><thead><tr><th>Time (UTC)</th><th>Level</th><th>Source</th><th>Message</th><th>User</th><th>Request</th></tr></thead><tbody>
@foreach (var entry in Model.Entries) { <tr><td class="text-nowrap">@entry.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@entry.Level</td><td>@entry.SourceContext?.Split('.').Last()</td><td class="text-break">@entry.Message @if (!string.IsNullOrEmpty(entry.Exception)) { <details><summary>View exception &amp; stack trace</summary><pre class="small text-break" style="white-space: pre-wrap">@entry.Exception</pre></details> }</td><td>@entry.UserId</td><td>@entry.RequestPath @entry.StatusCode @entry.RequestId</td></tr> }
</tbody></table></div>
@if (Model.TotalPages > 1) { <nav aria-label="Log pages" class="d-flex align-items-center gap-3">@if (Model.Page > 1) { var previous = new Dictionary<string, string?>(route) { ["Page"] = (Model.Page - 1).ToString() }; <a asp-action="AppLogs" asp-all-route-data="previous">Previous</a> }<span>Page @Model.Page of @Model.TotalPages</span>@if (Model.Page < Model.TotalPages) { var next = new Dictionary<string, string?>(route) { ["Page"] = (Model.Page + 1).ToString() }; <a asp-action="AppLogs" asp-all-route-data="next">Next</a> }</nav> }