@model ComdisAI.ViewModels.CustomerPriceLists.CustomerPriceListInputViewModel

@{
    ViewData["Title"] = "Edit price";
}

<style>
    .price-history > summary {
        cursor: pointer;
        list-style: none;
    }

    .price-history > summary::-webkit-details-marker {
        display: none;
    }

    .price-history-chevron {
        flex: 0 0 auto;
        transition: transform 0.15s ease-in-out;
        transform: rotate(-90deg);
    }

    .price-history[open] .price-history-chevron {
        transform: rotate(0);
    }
</style>

<h1 class="h2 mb-3">Edit price</h1>

<section class="card shadow-sm mb-4" aria-labelledby="price-details-heading">
    <div class="card-header">
        <h2 id="price-details-heading" class="h5 mb-0">Price details</h2>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <partial name="_Form" model="Model" />
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-action="Index" asp-route-customerId="@Model.CustomerId" class="btn btn-outline-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </form>
    </div>
</section>

<details class="card shadow-sm mb-4 price-history">
    <summary class="card-header d-flex align-items-center gap-2">
        <span class="d-flex justify-content-between align-items-center flex-grow-1">
            <span class="h5 mb-0">Price history</span>
            <span class="badge rounded-pill text-bg-secondary">@Model.History.Count</span>
        </span>
        <svg class="price-history-chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path fill-rule="evenodd" d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708" />
        </svg>
    </summary>
    <div class="card-body">
        @if (Model.History.Count == 0)
        {
            <p class="text-body-secondary mb-0">No price history is available for this product and customer.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <colgroup>
                        <col style="width: 20%" />
                        <col style="width: 20%" />
                        <col style="width: 27%" />
                        <col style="width: 33%" />
                    </colgroup>
                    <thead>
                        <tr>
                            <th scope="col" class="text-end text-nowrap">Previous price</th>
                            <th scope="col" class="text-end text-nowrap">New price</th>
                            <th scope="col" class="text-nowrap">Changed</th>
                            <th scope="col">Changed by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.History)
                        {
                            <tr>
                                <td class="text-end text-nowrap font-monospace">
                                    @(entry.PreviousPrice?.ToString("N4", System.Globalization.CultureInfo.InvariantCulture) ?? "Initial price")
                                </td>
                                <td class="text-end text-nowrap font-monospace">@entry.NewPrice.ToString("N4", System.Globalization.CultureInfo.InvariantCulture)</td>
                                <td class="text-nowrap">
                                    <time data-utc="@entry.CreatedAtUtc.ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture)">@entry.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</time>
                                </td>
                                <td>@Model.UserName(entry.CreatedBy)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</details>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_Select2Partial" />
    <script>
        document.querySelectorAll("time[data-utc]").forEach(el => {
            const date = new Date(el.dataset.utc);
            if (!isNaN(date)) el.textContent = date.toLocaleString([], { dateStyle: "short", timeStyle: "short" });
        });
    </script>
}
