@model Customer
@{
    var taxes = ViewData["Taxes"] as SelectList ?? new SelectList(Array.Empty<object>());
}

<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" maxlength="255" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Address" class="form-label"></label>
    <input asp-for="Address" class="form-control" maxlength="255" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="RFC" class="form-label"></label>
    <input asp-for="RFC" class="form-control" maxlength="25" />
    <span asp-validation-for="RFC" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="DefaultTaxId" class="form-label">Default tax</label>
    <select asp-for="DefaultTaxId" asp-items="taxes" class="form-select">
        <option value="">None</option>
    </select>
    <span asp-validation-for="DefaultTaxId" class="text-danger"></span>
</div>
