@using System.Security.Claims
@using ComdisAI.Models
@using ComdisAI.Services
@using System.Globalization
@inject IActionPermissionService PermissionService
@{
    var activeRoleId = int.TryParse(
        User.FindFirstValue(AuthorizationClaims.ActiveRoleId),
        NumberStyles.None,
        CultureInfo.InvariantCulture,
        out var parsedActiveRoleId)
        ? parsedActiveRoleId
        : (int?)null;
    var activeRoles = User.Identity?.IsAuthenticated == true &&
                      int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId)
        ? await PermissionService.GetActiveRolesAsync(currentUserId)
        : [];
    var activeRole = activeRoles.FirstOrDefault(role => role.Id == activeRoleId);
    var grantedActions = User.Identity?.IsAuthenticated == true
        ? (await PermissionService.GetActiveActionCodesAsync(User)).ToHashSet(StringComparer.Ordinal)
        : new HashSet<string>(StringComparer.Ordinal);
    var canViewBanks = grantedActions.Contains(AuthorizationActionCodes.ViewBank);
    var canViewUoms = grantedActions.Contains(AuthorizationActionCodes.ViewUom);
    var canViewProducts = grantedActions.Contains(AuthorizationActionCodes.ViewProduct);
    var canViewCustomers = grantedActions.Contains(AuthorizationActionCodes.ViewCustomer);
    var canViewActions = grantedActions.Contains(AuthorizationActionCodes.ViewAction);
    var canViewRoles = grantedActions.Contains(AuthorizationActionCodes.ViewRole);
    var canViewUsers = grantedActions.Contains(AuthorizationActionCodes.ViewUser);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ComdisAI</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ComdisAI.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                @if (grantedActions.Contains(AuthorizationActionCodes.ViewHome))
                {
                    <a class="navbar-brand" asp-controller="Home" asp-action="Index">ComdisAI</a>
                }
                else
                {
                    <span class="navbar-brand">ComdisAI</span>
                }
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between" id="navbarSupportedContent">
                    <ul class="navbar-nav flex-grow-1">
                        @if (grantedActions.Contains(AuthorizationActionCodes.ViewHome))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                        }
                        @if (canViewBanks || canViewUoms || canViewProducts)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Catalogs
                                </button>
                                <ul class="dropdown-menu">
                                    @if (canViewBanks)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Banks" asp-action="Index">Banks</a>
                                        </li>
                                    }
                                    @if (canViewUoms)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Uoms" asp-action="Index">Units of Measure</a>
                                        </li>
                                    }
                                    @if (canViewProducts)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Products" asp-action="Index">Products</a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        }
                        @if (canViewCustomers)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Sales
                                </button>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Customers" asp-action="Index">Customers</a>
                                    </li>
                                </ul>
                            </li>
                        }
                        @if (canViewActions || canViewRoles || canViewUsers)
                        {
                            <li class="nav-item dropdown">
                                <button class="nav-link dropdown-toggle text-dark" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                    Administrator
                                </button>
                                <ul class="dropdown-menu">
                                    <li class="dropend dropdown-submenu">
                                        <button class="dropdown-item dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Security
                                        </button>
                                        <ul class="dropdown-menu">
                                            @if (canViewActions)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Actions" asp-action="Index">Actions</a>
                                                </li>
                                            }
                                            @if (canViewRoles)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Roles" asp-action="Index">Roles</a>
                                                </li>
                                            }
                                            @if (canViewUsers)
                                            {
                                                <li>
                                                    <a class="dropdown-item" asp-controller="Users" asp-action="Index">Users</a>
                                                </li>
                                            }
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link text-dark">@User.Identity.Name — @(activeRole?.Code ?? "No active role")</span>
                            </li>
                            @if (activeRoles.Count > 1)
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-controller="Authentication" asp-action="SelectRole">Switch role</a>
                                </li>
                            }
                            <li class="nav-item">
                                <form asp-area="" asp-controller="Authentication" asp-action="Logout" method="post">
                                    <button type="submit" class="nav-link btn btn-link text-dark">Sign out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Authentication" asp-action="Login">Sign in</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ComdisAI
            @if (grantedActions.Contains(AuthorizationActionCodes.ViewPrivacy))
            {
                <span> - </span><a asp-controller="Home" asp-action="Privacy">Privacy</a>
            }
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
