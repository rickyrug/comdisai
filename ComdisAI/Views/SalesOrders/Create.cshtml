@model SalesOrderHeaderInputViewModel
@{
    ViewData["Title"] = "New sales order";
}

<h1>New sales order</h1>
<p>The order number is assigned automatically. The order starts in Draft.</p>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" asp-items="Model.Customers" class="form-select" data-searchable="true">
            <option value="">Select a customer</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DeliveryAddress" class="form-label"></label>
        <textarea asp-for="DeliveryAddress" class="form-control" maxlength="359"></textarea>
        <span asp-validation-for="DeliveryAddress" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DeliveryDate" class="form-label"></label>
        <input asp-for="DeliveryDate" asp-format="{0:yyyy-MM-dd}" type="date" class="form-control" />
        <span asp-validation-for="DeliveryDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TaxId" class="form-label">Tax</label>
        <select asp-for="TaxId" asp-items="Model.Taxes" class="form-select">
            <option value="">Select a tax</option>
        </select>
        <span asp-validation-for="TaxId" class="text-danger"></span>
    </div>
    <fieldset class="mb-3">
        <legend class="fs-6">Header discounts (%)</legend>
        <div class="row">
            <div class="col-md-4 mb-2">
                <label asp-for="DiscountPercent1" class="form-label">Discount 1</label>
                <input asp-for="DiscountPercent1" class="form-control" type="number" min="0" max="100" step="0.0001" />
                <span asp-validation-for="DiscountPercent1" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-2">
                <label asp-for="DiscountPercent2" class="form-label">Discount 2</label>
                <input asp-for="DiscountPercent2" class="form-control" type="number" min="0" max="100" step="0.0001" />
                <span asp-validation-for="DiscountPercent2" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-2">
                <label asp-for="DiscountPercent3" class="form-label">Discount 3</label>
                <input asp-for="DiscountPercent3" class="form-control" type="number" min="0" max="100" step="0.0001" />
                <span asp-validation-for="DiscountPercent3" class="text-danger"></span>
            </div>
        </div>
    </fieldset>
    <button type="submit" class="btn btn-primary">Create draft</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_Select2Partial" />
    <script>
        (function () {
            const addresses = @Json.Serialize(Model.CustomerAddresses);
            const customer = document.getElementById("CustomerId");
            const defaultTaxes = @Json.Serialize(Model.CustomerDefaultTaxes);
            const tax = document.getElementById("TaxId");
            const delivery = document.getElementById("DeliveryAddress");
            let lastAutoFilled = null;

            function apply() {
                const address = (addresses[customer.value] || "").substring(0, 359);
                const untouched = delivery.value.trim() === "" || delivery.value === lastAutoFilled;
                if (address && untouched) {
                    delivery.value = address;
                    lastAutoFilled = address;
                }
            }

            function applyTax() {
                const taxId = defaultTaxes[customer.value];
                if (taxId) tax.value = taxId;
            }

            customer.addEventListener("change", function () { apply(); applyTax(); });
            if (!tax.value) applyTax();
            apply();
        })();
    </script>
}
