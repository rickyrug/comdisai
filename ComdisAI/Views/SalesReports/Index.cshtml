@using System.Globalization
@model ComdisAI.ViewModels.SalesReports.SalesReportViewModel
@{
    ViewData["Title"] = "Sales Report";
    var currencyCulture = CultureInfo.GetCultureInfo("en-US");
}

<div class="mb-3">
    <h1>Sales Report</h1>
</div>

<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-sm-3 col-lg-2">
        <label asp-for="StartDate" class="form-label">From</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="col-sm-3 col-lg-2">
        <label asp-for="EndDate" class="form-label">To</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>
    <div class="col-sm-4 col-lg-3">
        <label asp-for="StatusIds" class="form-label">Statuses</label>
        <select asp-for="StatusIds" asp-items="Model.StatusOptions" class="form-select"
            data-searchable="true" data-placeholder="All statuses" data-no-results="No statuses found" multiple>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Run report</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<div asp-validation-summary="All" class="text-danger mb-3"></div>

@if (Model.StartDate is not null && Model.EndDate is not null && ViewData.ModelState.IsValid)
{
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Customer</th>
                    <th>Order</th>
                    <th>Status</th>
                    <th class="text-end">Total</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Orders.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">No sales orders match this report.</td>
                    </tr>
                }
                else
                {
                    @foreach (var order in Model.Orders)
                    {
                        <tr>
                            <td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderNumber</td>
                            <td>@order.StatusName</td>
                            <td class="text-end">@order.Total.ToString("C2", currencyCulture)</td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="text-end">Period total</th>
                    <th class="text-end">@Model.PeriodTotal.ToString("C2", currencyCulture)</th>
                </tr>
            </tfoot>
        </table>
    </div>

    @if (Model.StatusSummary.Count > 0)
    {
        <section class="mt-4">
            <h2 class="h5">Summary by status</h2>
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th class="text-end">Orders</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var summary in Model.StatusSummary)
                        {
                            <tr>
                                <td>@summary.StatusName</td>
                                <td class="text-end">@summary.OrderCount</td>
                                <td class="text-end">@summary.Total.ToString("C2", currencyCulture)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
}

@section Scripts {
    <partial name="_Select2Partial" />
}