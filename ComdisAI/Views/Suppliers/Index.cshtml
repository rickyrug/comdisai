@model IReadOnlyList<Supplier>

@{
    ViewData["Title"] = "Suppliers";
    var bankNames = ViewData["BankNames"] as Dictionary<int, string> ?? new Dictionary<int, string>();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Suppliers</h1>
    <a asp-action="Create" class="btn btn-primary">Add supplier</a>
</div>

@if (Model.Count == 0)
{
    <p>No suppliers have been added yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Address</th>
                <th>RFC</th>
                <th>Bank</th>
                <th>Bank account</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var supplier in Model)
            {
                <tr>
                    <td>@supplier.Name</td>
                    <td>@supplier.Address</td>
                    <td>@supplier.RFC</td>
                    <td>@(bankNames.TryGetValue(supplier.BankId, out var bankName) ? bankName : "—")</td>
                    <td>@supplier.BankAccount</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
