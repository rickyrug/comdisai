@model ComdisAI.ViewModels.Users.ResetUserPasswordViewModel

@{
    ViewData["Title"] = "Reset password";
}

<h1>Reset password</h1>
<p>Set a new password for <strong>@Model.Email</strong>.</p>
<form asp-action="ResetPassword" asp-route-id="@Model.Id" method="post" class="col-md-6">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Email" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Password" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ConfirmPassword" class="form-label"></label>
        <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Reset password</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
