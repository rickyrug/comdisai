@model IReadOnlyList<ComdisAI.ViewModels.Users.UserListItemViewModel>

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Users</h1>
    <a asp-action="Create" class="btn btn-primary">Add user</a>
</div>

@if (Model.Count == 0)
{
    <p>No users have been added yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Surname</th>
                <th>Email</th>
                <th>Last login (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@user.Name</td>
                    <td>@user.Surname</td>
                    <td>@user.Email</td>
                    <td>@(user.LastLoginDateUtc?.ToString("u") ?? "Never")</td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a asp-action="ManageRoles" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Manage roles</a>
                        <a asp-action="ResetPassword" asp-route-id="@user.Id" class="btn btn-sm btn-outline-secondary">Reset password</a>
                        <form asp-action="Delete" asp-route-id="@user.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
