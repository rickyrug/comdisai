@model IReadOnlyList<ProductCategory>

@{
    ViewData["Title"] = "Product Categories";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Product Categories</h1>
    <a asp-action="Create" class="btn btn-primary">Add category</a>
</div>

@if (Model.Count == 0)
{
    <p>No product categories have been added yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Prefix</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Name</td>
                    <td>@category.Prefix</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
