@model ComdisAI.ViewModels.Roles.ManageRoleActionsViewModel

@{
    ViewData["Title"] = "Manage Role Actions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Actions for @Model.RoleCode</h1>
    <a asp-action="Index" class="btn btn-secondary">Back to Roles</a>
</div>

<form asp-action="AddAction" asp-route-id="@Model.RoleId" method="post" class="row g-2 align-items-end mb-4">
    <input asp-for="RoleId" type="hidden" />
    <div class="col-md-6">
        <label asp-for="ActionId" class="form-label">Available action</label>
        <select asp-for="ActionId" asp-items="Model.AvailableActions" class="form-select">
            <option value="">Select an action</option>
        </select>
        <span asp-validation-for="ActionId" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary" disabled="@(Model.AvailableActions.Count == 0)">Assign Action</button>
    </div>
</form>

@if (Model.AssignedActions.Count == 0)
{
    <p>No actions are assigned to this role.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var action in Model.AssignedActions)
            {
                <tr>
                    <td>@action.Code</td>
                    <td>@action.Description</td>
                    <td>@(action.IsDeleted ? "Deleted" : "Active")</td>
                    <td class="text-end">
                        <form asp-action="RemoveAction" asp-route-id="@Model.RoleId" asp-route-roleActionId="@action.RoleActionId" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
