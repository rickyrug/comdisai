@model IReadOnlyList<Role>

@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Roles</h1>
    <a asp-action="Create" class="btn btn-primary">Add Role</a>
</div>

@if (Model.Count == 0)
{
    <p>No roles have been added yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                <tr>
                    <td>@role.Code</td>
                    <td>@role.Description</td>
                    <td class="text-end">
                        <a asp-action="ManageActions" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary">Actions</a>
                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="Delete" asp-route-id="@role.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
