@model IReadOnlyList<Actions>

@{
    ViewData["Title"] = "Actions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Actions</h1>
    <a asp-action="Create" class="btn btn-primary">Add Action</a>
</div>

@if (Model.Count == 0)
{
    <p>No actions have been added yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Description</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var action in Model)
            {
                <tr>
                    <td>
                        @action.Code
                        @if (action.IsSystem)
                        {
                            <span class="badge text-bg-secondary">System</span>
                        }
                    </td>
                    <td>@action.Description</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@action.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        @if (!action.IsSystem)
                        {
                            <form asp-action="Delete" asp-route-id="@action.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this action?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
