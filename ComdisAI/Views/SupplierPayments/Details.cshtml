@using System.Globalization
@model SupplierPayment
@{
    ViewData["Title"] = "Supplier Payment";
    var us = CultureInfo.GetCultureInfo("en-US");
    var allocated = Model.Allocations.Sum(a => a.Amount);
    var unallocated = Model.Amount - allocated;
    var openOrders = (IReadOnlyList<ComdisAI.Services.OpenPurchaseOrderBalance>)ViewData["OpenOrders"]!;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Payment from @Model.Supplier.Name</h1>
    <div>
        @if (ViewData["CanEdit"] is true)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        }
        @if (ViewData["CanDelete"] is true)
        {
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Delete this payment and its allocations?');">
                <button type="submit" class="btn btn-outline-danger">Delete</button>
            </form>
        }
        <a class="btn btn-secondary" asp-action="Index">Back</a>
    </div>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }

<dl class="row">
    <dt class="col-sm-3">Date</dt><dd class="col-sm-9">@Model.PaymentDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">Method</dt><dd class="col-sm-9">@Model.Method</dd>
    <dt class="col-sm-3">Reference</dt><dd class="col-sm-9">@Model.Reference</dd>
    <dt class="col-sm-3">Bank</dt><dd class="col-sm-9">@Model.Bank?.Name</dd>
    <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd>
    <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">@Model.Amount.ToString("C2", us)</dd>
    <dt class="col-sm-3">Allocated</dt><dd class="col-sm-9">@allocated.ToString("C2", us)</dd>
    <dt class="col-sm-3">Unallocated</dt><dd class="col-sm-9">@unallocated.ToString("C2", us)</dd>
</dl>

<h2 class="h4">Allocations</h2>
@if (Model.Allocations.Count == 0)
{
    <p>This payment has not been allocated to any purchase order.</p>
}
else
{
    <table class="table table-striped">
        <thead><tr><th>Order</th><th class="text-end">Allocated</th><th></th></tr></thead>
        <tbody>
            @foreach (var allocation in Model.Allocations.OrderBy(a => a.PurchaseOrderHeader.OrderNumber))
            {
                <tr>
                    <td><a asp-controller="PurchaseOrders" asp-action="Details" asp-route-id="@allocation.PurchaseOrderHeaderId">@allocation.PurchaseOrderHeader.OrderNumber</a></td>
                    <td class="text-end">@allocation.Amount.ToString("C2", us)</td>
                    <td class="text-end">
                        @if (ViewData["CanAllocate"] is true)
                        {
                            <form asp-action="RemoveAllocation" asp-route-id="@Model.Id" asp-route-allocationId="@allocation.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (ViewData["CanAllocate"] is true && unallocated > 0m)
{
    <h2 class="h4">Allocate to a purchase order</h2>
    @if (openOrders.Count == 0)
    {
        <p>This supplier has no approved or supplied orders with an outstanding balance.</p>
    }
    else
    {
        <form asp-action="Allocate" asp-route-id="@Model.Id" method="post" class="row g-2">
            <div class="col-md-5">
                <select name="purchaseOrderId" class="form-select" required>
                    <option value="">Select an order</option>
                    @foreach (var order in openOrders)
                    {
                        <option value="@order.OrderId">@order.OrderNumber — balance @order.Balance.ToString("C2", us)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input name="amount" class="form-control" value="@unallocated.ToString("0.00##", CultureInfo.InvariantCulture)" required />
            </div>
            <div class="col-auto"><button type="submit" class="btn btn-primary">Allocate</button></div>
        </form>
    }
}
