@using System.Globalization
@model IReadOnlyList<SupplierPayment>
@{
    ViewData["Title"] = "Supplier Payments";
    var us = CultureInfo.GetCultureInfo("en-US");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Supplier Payments</h1>
    @if (ViewData["CanCreate"] is true)
    {
        <a class="btn btn-primary" asp-action="Create">Record payment</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto"><input name="q" value="@ViewData["Query"]" class="form-control" placeholder="Supplier or reference" /></div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Search</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Date</th><th>Supplier</th><th>Method</th><th>Reference</th>
            <th class="text-end">Amount</th><th class="text-end">Unallocated</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model)
        {
            <tr>
                <td>@payment.PaymentDate.ToString("yyyy-MM-dd")</td>
                <td>@payment.Supplier.Name</td>
                <td>@payment.Method</td>
                <td>@payment.Reference</td>
                <td class="text-end">@payment.Amount.ToString("C2", us)</td>
                <td class="text-end">@((payment.Amount - payment.Allocations.Sum(a => a.Amount)).ToString("C2", us))</td>
                <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@payment.Id">Open</a></td>
            </tr>
        }
    </tbody>
</table>
